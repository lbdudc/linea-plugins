# URL of your running SPLALM backend
SPLALM_BASE_URL=http://localhost:3000

# JWT obtained by logging into SPLALM once via the browser.
# The MCP will auto-refresh it using POST /api/users/loginFromServiceToken
# before it expires (~115 min). Re-issue it here if the session is fully lost.
SPLALM_JWT=

# MongoDB _id of the Software Product Line this MCP manages.
SPL_LINE_ID=

# Set to "true" to disable all mutating tools (update/create/delete/synchronize).
MCP_READ_ONLY=false

# Log verbosity: "info" (default) or "debug"
MCP_LOG_LEVEL=info

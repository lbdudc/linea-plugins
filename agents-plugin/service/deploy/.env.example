# linea-agents' service deploy: copy to .env and fill in. Secrets that should not be here (ANTHROPIC_API_KEY) go in ../server/.env.local.
# There is no login and no web here: people use the agents in LINEA (the agents-plugin), and LINEA's server calls this service.

# The port LINEA's server reaches the service on (LINEA: AGENTS_URL=http://<this host>:3001)
AGENTS_PORT=3001
NODE_ENV=production

# The key LINEA and the service share: any long random string. LINEA: AGENTS_SERVICE_KEY=<it> and LINEA_SERVICE_KEYS=agents-plugin:<it>
AGENTS_SERVICE_KEY=

# Where LINEA's API is (what agents calls, as the people LINEA says are signed in)
LINEA_API_URL=http://localhost:9000

# The git host is LINEA's business, not this service's: agents reads and writes the repositories through LINEA's API.

# The key LINEA signs its events with (LINEA: EVENT_WEBHOOK_SECRET, same value; LINEA sends them while the plugin is on): the pushes to the
# products and the generations that end in conflicts arrive as those events
EVENT_WEBHOOK_SECRET=

# The person background work (scheduler, push hooks, events) acts as: a LINEA username that has signed in to LINEA once and that is a
# maintainer of the products
BOT_USER=
AGENTS_BACKGROUND_TRIGGERS=on

# Optional: another database, a feature-model analysis service
# MONGO_URL=
# FLAMAPY_API_URL=

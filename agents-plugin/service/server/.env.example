PORT=3001
mongoUrl=

# There is no login here: people sign in to LINEA. The key LINEA and this service share (LINEA: AGENTS_SERVICE_KEY, and
# LINEA_SERVICE_KEYS=agents-plugin:<key>): LINEA's server presents it to this one, and this one to LINEA
AGENTS_SERVICE_KEY=

# LINEA: the API agents calls (as the person it acts for)
LINEA_API_URL=http://localhost:9000

# The key LINEA signs its events with (pushes to the products, generations)
EVENT_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=

EMBEDDINGS_URL=http://localhost:8082
EMBEDDINGS_API_KEY=

# Optional feature-model analysis service
FLAMAPY_API_URL=

# Background work (scheduler, push hooks, events, reconcile) acts as BOT_USER: a LINEA username (one that has signed in to LINEA)
BOT_USER=
AGENTS_BACKGROUND_TRIGGERS=on
HEALTH_INTERVAL_MS=
SYNC_RECONCILE_INTERVAL_MS=
PUSH_HOOK_SYNC_INTERVAL_MS=

NETPROBE_LOG=
